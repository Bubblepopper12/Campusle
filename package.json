{
  "name": "campusle",
  "version": "1.0.0",
  "private": true,
  "description": "Campusle: a free daily college-guessing game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "data:build": "tsx scripts/build-data.ts",
    "data:offline": "tsx scripts/offline-data.ts",
    "data:report": "tsx scripts/report-data.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/cabin-sketch": "5.3.0",
    "@fontsource/graduate": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
